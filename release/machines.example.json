  "linux": {
    "host": "cuda-test",
    "identity_file": "~/.ssh/release_ed25519",
    "root": "/path/to/release-candidates",
    "models": "/path/to/models",
    "dependencies": "/path/to/linux-qualification/bundle.json",
    "dependencies_sha256": "REPLACE_WITH_SHA256_OF_LINUX_BUNDLE_JSON",
    "dependency_cache": "/path/to/shared/dependency-cache",
    "build_cache": "/path/to/shared/tool-downloads",
    "jobs": 8
  }
}
