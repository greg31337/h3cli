{
  "schema": 1,
  "macos": {
    "models": "/path/to/models",
    "dependencies": "/path/to/macos-qualification/bundle.json",
    "dependencies_sha256": "REPLACE_WITH_SHA256_OF_MACOS_BUNDLE_JSON",
    "dependency_cache": "/path/to/shared/dependency-cache",
    "build_cache": "/path/to/shared/tool-downloads",
    "apple_identity": "",
    "notary_profile": "h3cli",
